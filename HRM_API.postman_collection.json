    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    var accessToken = jsonData.token;",
                                    "    ",
                                    "    // Save access token to collection and environment variables",
                                    "    pm.collectionVariables.set(\"jwt_token\", accessToken);",
                                    "    pm.environment.set(\"jwt_token\", accessToken);",
                                    "    ",
                                    "    // Log authentication details",
                                    "    console.log(\"====== Authentication Successful ======\");",
                                    "    console.log(\"Access Token: \" + accessToken);",
                                    "    console.log(\"Token Type: \" + jsonData.type);",
                                    "    console.log(\"User ID: \" + jsonData.id);",
                                    "    console.log(\"Username: \" + jsonData.username);",
                                    "    console.log(\"Email: \" + jsonData.email);",
                                    "    console.log(\"Roles: \" + JSON.stringify(jsonData.roles));",
                                    "    console.log(\"=======================================\");",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Authenticate user and receive JWT access token. The access token (jsonData.token) is automatically extracted and saved to the 'jwt_token' variable for use in all subsequent authenticated requests."
                    },
                    "response": []
                }
            ],
            "description": "Authentication endpoints"
        },
